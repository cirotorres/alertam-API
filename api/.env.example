# Ambiente: development | test | production
ENVIRONMENT=development

# Persistência:
# - memory: testes/desenvolvimento sem banco
# - postgres: desenvolvimento local com PostgreSQL direto
# - supabase: produção
PERSISTENCE_BACKEND=memory

# PostgreSQL local (usado quando PERSISTENCE_BACKEND=postgres).
DATABASE_URL=

# Supabase — deixe vazio fora de produção/Supabase.
SUPABASE_URL=
# Preferencial para novos projetos; somente backend.
SUPABASE_SECRET_KEY=
# Fallback legado temporário. Não preencher se usar SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

STALE_AFTER_SECONDS=120

# CORS: lista separada por vírgulas. Vazio = same-origin/sem origens extras.
ALLOWED_ORIGINS=

LOG_LEVEL=INFO

# Seed opcional do repository em memória.
MOCK_SEED_DEVICE=true
MOCK_DEVICE_ID=pecem-01
MOCK_DEVICE_SECRET=change-this-local-device-secret
MOCK_VIEW_SECRET=change-this-local-view-secret
