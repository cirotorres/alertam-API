# Desenvolvimento local:
# ENVIRONMENT=development
# PERSISTENCE_BACKEND=memory
#
# Produção na Vercel (obrigatório):
# ENVIRONMENT=production
# PERSISTENCE_BACKEND=supabase
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_...
ENVIRONMENT=development

# Persistência: memory para desenvolvimento/testes; supabase em produção.
# A aplicação recusa ENVIRONMENT=production + PERSISTENCE_BACKEND=memory.
PERSISTENCE_BACKEND=memory

# Supabase — deixe vazio enquanto usar PERSISTENCE_BACKEND=memory.
SUPABASE_URL=
# Preferencial para novos projetos; somente backend.
SUPABASE_SECRET_KEY=
# Fallback legado temporário. Não preencher se usar SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=

# Regra de disponibilidade do coletor.
STALE_AFTER_SECONDS=120

# CORS: lista separada por vírgulas. Vazio = nenhuma origem adicional.
ALLOWED_ORIGINS=

# Logging.
LOG_LEVEL=INFO

# Seed opcional do repository em memória para desenvolvimento local.
MOCK_SEED_DEVICE=true
MOCK_DEVICE_ID=pecem-01
MOCK_DEVICE_SECRET=change-this-local-device-secret
MOCK_VIEW_SECRET=change-this-local-view-secret
